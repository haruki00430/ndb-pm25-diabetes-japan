.cursor/
.gemini/
.obsidian/
.vscode/

__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.env
.env.*
*.egg-info/
.claude/settings.local.json

02_Data/raw/
02_Data/processed/
*.csv
*.xlsx
*.parquet
*.sqlite
*.db

# Allow public release dataset
!data/release/
!data/release/*.csv
!data/release/README.md

# Internal dev artifacts (not for public release)
HANDOVER.md
scriptsstatic_tables_output.md
scripts/citation_mapping.txt
scripts/ref_mapping_final.txt
scripts/static_tables_output.md

# Manuscript drafts, backups, and auto-generated files
04_Manuscripts/*.backup
04_Manuscripts/*.backup_*
04_Manuscripts/*_converted.qmd
04_Manuscripts/*_final.qmd
04_Manuscripts/*_placeholder*.qmd
04_Manuscripts/*_reversed.qmd
